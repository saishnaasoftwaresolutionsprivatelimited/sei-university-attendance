<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SEI University - Student Attendance &amp; Parent Notification System</title>
  
  <!-- Modern Inter Typography with System Fallbacks -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Primary Application Stylesheet -->
  <link rel="stylesheet" href="/style.css">
  
  <!-- Browser Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>">
</head>
<body>

  <!-- ==================== HEADER ==================== -->
  <header class="app-header">
    <div class="header-container">
      <div class="brand-section">
        <div class="brand-crest">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <div class="brand-text">
          <h1 class="brand-title">SEI UNIVERSITY</h1>
          <p class="brand-subtitle">Student Attendance &amp; Parent Notification System</p>
        </div>
      </div>
      
      <div class="header-meta">
        <div class="status-badge" id="gmail-header-badge">
          <span class="pulse-dot" id="gmail-pulse-dot"></span>
          <span id="gmail-header-text">Gmail Connected</span>
        </div>
        <div class="status-badge">
          <span class="pulse-dot"></span>
          <span>System Online &bull; Port 3100</span>
        </div>
        <div class="date-badge" id="live-datetime">Loading...</div>
      </div>
    </div>
  </header>

  <!-- ==================== MAIN NAVIGATION TABS ==================== -->
  <nav class="main-navigation">
    <div class="nav-container">
      <button type="button" class="nav-tab active" data-tab="dashboard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>1. Dashboard &amp; Daily Attendance</span>
      </button>

      <button type="button" class="nav-tab" data-tab="students">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>2. Student Management</span>
      </button>

      <button type="button" class="nav-tab" data-tab="notifications">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span>3. Parent Notification Center</span>
        <span class="tab-badge" id="absent-badge" style="display:none">0</span>
      </button>

      <button type="button" class="nav-tab" data-tab="reports">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span>4. Attendance Reports</span>
      </button>
    </div>
  </nav>

  <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
  <main class="main-content">

    <!-- ==================== TAB 1: DASHBOARD & DAILY ATTENDANCE ==================== -->
    <section id="tab-dashboard" class="tab-pane active">
      <!-- KPI Stats Grid -->
      <div class="kpi-grid">
        <div class="kpi-card card-total">
          <div class="kpi-header">
            <span class="kpi-label">Total Enrolled</span>
            <div class="kpi-icon indigo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            </div>
          </div>
          <div class="kpi-value" id="stat-total">0</div>
          <div class="kpi-footer">Registered active students</div>
        </div>

        <div class="kpi-card card-present">
          <div class="kpi-header">
            <span class="kpi-label">Present Today</span>
            <div class="kpi-icon emerald">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
          <div class="kpi-value" id="stat-present">0</div>
          <div class="kpi-footer emerald-text" id="stat-present-rate">0% of enrolled</div>
        </div>

        <div class="kpi-card card-absent">
          <div class="kpi-header">
            <span class="kpi-label">Absent Today</span>
            <div class="kpi-icon rose">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
          </div>
          <div class="kpi-value" id="stat-absent">0</div>
          <div class="kpi-footer rose-text">Parent alerts required</div>
        </div>

        <div class="kpi-card card-late">
          <div class="kpi-header">
            <span class="kpi-label">Late Arrivals</span>
            <div class="kpi-icon amber">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
          </div>
          <div class="kpi-value" id="stat-late">0</div>
          <div class="kpi-footer amber-text">Permitted with remark</div>
        </div>

        <div class="kpi-card card-percentage">
          <div class="kpi-header">
            <span class="kpi-label">Attendance Rate</span>
            <div class="kpi-icon blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
            </div>
          </div>
          <div class="kpi-value" id="stat-rate">0%</div>
          <div class="progress-bar-container">
            <div class="progress-bar-fill" id="stat-progress" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <!-- Controls & Filter Toolbar -->
      <div class="content-card toolbar-card">
        <div class="toolbar-row">
          <div class="toolbar-group">
            <label class="field-label" for="attendance-day">Attendance Date</label>
            <div class="date-controls">
              <button type="button" class="btn btn-secondary btn-icon" id="prev-day-btn" title="Previous Day">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <input type="date" id="attendance-day" class="form-input date-input">
              <button type="button" class="btn btn-secondary btn-icon" id="next-day-btn" title="Next Day">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
              <button type="button" class="btn btn-secondary" id="today-btn">Today</button>
            </div>
          </div>

          <div class="toolbar-group">
            <label class="field-label" for="dept-filter">Department / Course</label>
            <select id="dept-filter" class="form-input form-select">
              <option value="ALL">All Departments &amp; Courses</option>
            </select>
          </div>

          <div class="toolbar-group flex-grow">
            <label class="field-label" for="roster-search">Quick Search</label>
            <div class="search-input-wrapper">
              <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input type="text" id="roster-search" class="form-input search-input" placeholder="Search by roll number or student name...">
            </div>
          </div>

          <div class="toolbar-actions">
            <button type="button" class="btn btn-secondary" id="mark-all-present-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Mark All Present</span>
            </button>
            <button type="button" class="btn btn-primary" id="review-alerts-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
              <span>Review &amp; Send Alerts</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Student Roll Call Table -->
      <div class="content-card table-card">
        <div class="card-header-row">
          <div>
            <h2 class="card-title">Daily Roll Call Register</h2>
            <p class="card-subtitle" id="roster-subtitle">Showing all enrolled students for selected date</p>
          </div>
          <span class="badge badge-info" id="roster-count-badge">0 Students</span>
        </div>

        <div class="table-responsive">
          <table class="data-table" id="roster-table">
            <thead>
              <tr>
                <th style="width: 140px;">Roll Number</th>
                <th>Student Name</th>
                <th>Course &amp; Department</th>
                <th style="width: 130px;">Year &amp; Section</th>
                <th style="width: 140px;">Attendance Status</th>
                <th style="width: 250px;">Record Status</th>
                <th style="width: 160px; text-align: right;">Parent Notification</th>
              </tr>
            </thead>
            <tbody id="roster-body">
              <tr>
                <td colspan="7" class="empty-state">Loading attendance records...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>


    <!-- ==================== TAB 2: STUDENT MANAGEMENT ==================== -->
    <section id="tab-students" class="tab-pane">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Student Management Directory</h2>
          <p class="section-subtitle">Maintain enrolled student records, parent contact details, and messaging consents</p>
        </div>
        <button type="button" class="btn btn-primary" id="add-student-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add New Student</span>
        </button>
      </div>

      <!-- Filters Card -->
      <div class="content-card toolbar-card">
        <div class="toolbar-row">
          <div class="toolbar-group flex-grow">
            <label class="field-label" for="student-search">Search Students</label>
            <div class="search-input-wrapper">
              <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input type="text" id="student-search" class="form-input search-input" placeholder="Search by roll number, name, parent name, or email...">
            </div>
          </div>

          <div class="toolbar-group">
            <label class="field-label" for="student-dept-filter">Department</label>
            <select id="student-dept-filter" class="form-input form-select">
              <option value="ALL">All Departments</option>
            </select>
          </div>

          <div class="toolbar-group">
            <label class="field-label" for="student-year-filter">Academic Year</label>
            <select id="student-year-filter" class="form-input form-select">
              <option value="ALL">All Years</option>
              <option value="1st Year">1st Year</option>
              <option value="2nd Year">2nd Year</option>
              <option value="3rd Year">3rd Year</option>
              <option value="4th Year">4th Year</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Student Directory Table -->
      <div class="content-card table-card">
        <div class="card-header-row">
          <div>
            <h3 class="card-title">Enrolled Students</h3>
            <p class="card-subtitle" id="student-table-subtitle">All active university students registered in database</p>
          </div>
          <span class="badge badge-info" id="student-count-badge">0 Students</span>
        </div>

        <div class="table-responsive">
          <table class="data-table" id="students-table">
            <thead>
              <tr>
                <th style="width: 140px;">Roll No</th>
                <th>Student Name</th>
                <th>Course &amp; Department</th>
                <th style="width: 130px;">Year &amp; Sec</th>
                <th>Parent Contact</th>
                <th style="width: 190px;">Parent Consents</th>
                <th style="width: 140px; text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody id="students-body">
              <tr>
                <td colspan="7" class="empty-state">Loading registered students...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>


    <!-- ==================== TAB 3: PARENT NOTIFICATION CENTER ==================== -->
    <section id="tab-notifications" class="tab-pane">
      <!-- Guidance Banner -->
      <div class="alert-banner info-banner">
        <div class="banner-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </div>
        <div class="banner-content">
          <strong>Official University Multi-Channel Notification Protocol</strong>
          <p>Automatic emails are securely dispatched via your configured university Gmail SMTP. WhatsApp and SMS links provide one-click manual chat and SMS pre-composed links to the parent's verified contact numbers. <em>Manual messages must be dispatched by staff in their messaging application; the system never claims manual messages were sent automatically.</em></p>
        </div>
      </div>

      <!-- Gmail Server Connection Status Card -->
      <div class="content-card" style="margin-bottom: 20px;">
        <div class="card-header-row">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div class="kpi-icon emerald" id="gmail-status-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <h3 class="card-title" id="gmail-card-title">University Gmail Server: Connected</h3>
              <p class="card-subtitle" id="gmail-card-subtitle">Host: smtp.gmail.com:587 (TLS Enabled) &bull; Authenticated Account</p>
            </div>
          </div>
          <div class="toolbar-actions">
            <button type="button" class="btn btn-secondary" id="test-gmail-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Test Gmail Connection</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Absent Student Alerts Panel -->
      <div class="content-card">
        <div class="card-header-row">
          <div>
            <h2 class="card-title">Absentee Alerts Dispatch Queue</h2>
            <p class="card-subtitle">Review absent students for the selected date and dispatch parental notifications</p>
          </div>
          <div class="date-controls">
            <input type="date" id="notice-day" class="form-input date-input">
            <button type="button" class="btn btn-secondary" id="notice-refresh-btn">Refresh</button>
          </div>
        </div>

        <div id="absent-queue-container" class="queue-container">
          <div class="empty-state">No absent students recorded for this date.</div>
        </div>
      </div>

      <!-- Notification History Logs -->
      <div class="content-card table-card" style="margin-top: 24px;">
        <div class="card-header-row">
          <div>
            <h3 class="card-title">Notification Activity &amp; Audit Logs</h3>
            <p class="card-subtitle">Complete log of all dispatched emails and manual messaging triggers</p>
          </div>
          <div class="toolbar-actions" style="margin-left: auto;">
            <div class="filter-pills">
              <button type="button" class="pill-filter active" data-channel="ALL">All Channels</button>
              <button type="button" class="pill-filter" data-channel="EMAIL">Gmail</button>
              <button type="button" class="pill-filter" data-channel="WHATSAPP">WhatsApp</button>
              <button type="button" class="pill-filter" data-channel="SMS">SMS</button>
            </div>
            <button type="button" class="btn btn-secondary btn-icon" id="refresh-alerts-btn" title="Refresh Notification Logs">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            </button>
            <button type="button" class="btn btn-secondary" id="clear-all-alerts-btn" style="font-size: 0.78rem; padding: 6px 12px;" title="Clear Notification Logs">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Clear Logs</span>
            </button>
          </div>
        </div>

        <div class="table-responsive">
          <table class="data-table" id="alerts-table">
            <thead>
              <tr>
                <th style="width: 100px;">Date</th>
                <th>Student</th>
                <th>Parent &amp; Recipient</th>
                <th style="width: 110px;">Channel</th>
                <th style="width: 140px;">Delivery Status</th>
                <th>Message Content</th>
                <th style="width: 170px; text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody id="alerts-body">
              <tr>
                <td colspan="7" class="empty-state">No notification logs recorded yet.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>


    <!-- ==================== TAB 4: ATTENDANCE REPORTS ==================== -->
    <section id="tab-reports" class="tab-pane">
      <!-- Report Type Selector Bar -->
      <div class="report-nav-bar">
        <button type="button" class="report-tab active" data-report="daily">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Daily Attendance Report</span>
        </button>
        <button type="button" class="report-tab" data-report="monthly">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg>
          <span>Monthly Attendance Report</span>
        </button>
        <button type="button" class="report-tab" data-report="student">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Student-wise Attendance Report</span>
        </button>
      </div>

      <!-- Report Filters Toolbar -->
      <div class="content-card toolbar-card" style="margin-top: 16px;">
        <div class="toolbar-row">
          <!-- Daily Filter -->
          <div class="toolbar-group report-control report-daily-control">
            <label class="field-label" for="report-day">Report Date</label>
            <input type="date" id="report-day" class="form-input date-input">
          </div>

          <!-- Monthly Filter -->
          <div class="toolbar-group report-control report-monthly-control" style="display:none">
            <label class="field-label" for="report-month">Report Month</label>
            <input type="month" id="report-month" class="form-input date-input">
          </div>

          <!-- Student Filter -->
          <div class="toolbar-group report-control report-student-control flex-grow" style="display:none">
            <label class="field-label" for="report-student-select">Select Student</label>
            <select id="report-student-select" class="form-input form-select">
              <option value="">-- Choose a student --</option>
            </select>
          </div>

          <!-- Department Filter -->
          <div class="toolbar-group report-control report-dept-control">
            <label class="field-label" for="report-dept">Department Filter</label>
            <select id="report-dept" class="form-input form-select">
              <option value="ALL">All Departments</option>
            </select>
          </div>

          <!-- Actions -->
          <div class="toolbar-actions">
            <button type="button" class="btn btn-secondary" id="generate-report-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              <span>Refresh Report</span>
            </button>
            <button type="button" class="btn btn-primary" id="export-csv-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Export CSV</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Report View Container -->
      <div id="report-view-container" style="margin-top: 16px;">
        <!-- Dynamically injected report cards and tables -->
      </div>
    </section>

  </main>


  <!-- ==================== MODAL: ADD / EDIT STUDENT ==================== -->
  <dialog id="student-modal" class="app-dialog">
    <div class="dialog-card">
      <div class="dialog-header">
        <div>
          <h2 class="dialog-title" id="student-modal-title">Add New Student</h2>
          <p class="dialog-subtitle">Fill in student academic information and verified parent contacts</p>
        </div>
        <button type="button" class="close-btn" id="close-student-modal-btn">&times;</button>
      </div>

      <form id="student-form" class="dialog-form">
        <input type="hidden" name="id" id="form-student-id">

        <div class="form-grid">
          <div class="form-group">
            <label class="field-label" for="form-roll-no">Roll Number <span class="required">*</span></label>
            <input type="text" id="form-roll-no" name="roll_no" class="form-input" required placeholder="e.g. SEI-2026-CSE-010" maxlength="50">
          </div>

          <div class="form-group">
            <label class="field-label" for="form-full-name">Student Full Name <span class="required">*</span></label>
            <input type="text" id="form-full-name" name="full_name" class="form-input" required placeholder="e.g. Kalai Arasan" maxlength="100">
          </div>

          <div class="form-group">
            <label class="field-label" for="form-course">Course / Degree <span class="required">*</span></label>
            <input type="text" id="form-course" name="course" class="form-input" required placeholder="e.g. B.Tech, M.Tech, MBA" maxlength="100">
          </div>

          <div class="form-group">
            <label class="field-label" for="form-department">Department <span class="required">*</span></label>
            <input type="text" id="form-department" name="department" class="form-input" required placeholder="e.g. Computer Science, Mechanical" maxlength="100">
          </div>

          <div class="form-group">
            <label class="field-label" for="form-year">Academic Year</label>
            <select id="form-year" name="year" class="form-input form-select">
              <option value="1st Year">1st Year</option>
              <option value="2nd Year">2nd Year</option>
              <option value="3rd Year">3rd Year</option>
              <option value="4th Year">4th Year</option>
            </select>
          </div>

          <div class="form-group">
            <label class="field-label" for="form-section">Section</label>
            <input type="text" id="form-section" name="section" class="form-input" placeholder="e.g. A, B, C" maxlength="20" value="A">
          </div>

          <div class="form-group full-width">
            <label class="field-label" for="form-parent-name">Parent / Guardian Name <span class="required">*</span></label>
            <input type="text" id="form-parent-name" name="parent_name" class="form-input" required placeholder="e.g. Mr. K. Kumar" maxlength="100">
          </div>

          <div class="form-group full-width">
            <label class="field-label" for="form-parent-email">Parent Email Address <span class="required">*</span></label>
            <input type="email" id="form-parent-email" name="parent_email" class="form-input" required placeholder="parent@example.com">
          </div>

          <div class="form-group">
            <label class="field-label" for="form-parent-phone">Parent Mobile Phone (SMS) <span class="required">*</span></label>
            <input type="tel" id="form-parent-phone" name="parent_phone" class="form-input" required placeholder="10-digit mobile number">
          </div>

          <div class="form-group">
            <label class="field-label" for="form-parent-whatsapp">Parent WhatsApp Number <span class="required">*</span></label>
            <input type="tel" id="form-parent-whatsapp" name="parent_whatsapp" class="form-input" required placeholder="10-digit WhatsApp number">
          </div>
        </div>

        <!-- Consents Box -->
        <div class="consent-box">
          <h4 class="consent-title">Parental Messaging Consent Record</h4>
          <p class="consent-subtitle">Separately record parent's explicit opt-in preferences for institutional communications:</p>
          
          <label class="checkbox-label">
            <input type="checkbox" id="form-whatsapp-consent" name="whatsapp_consent">
            <span>Parent has explicitly opted-in to receive WhatsApp attendance notifications</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" id="form-sms-consent" name="sms_consent">
            <span>Parent has consented to receive SMS attendance alert messages</span>
          </label>
        </div>

        <div class="dialog-actions">
          <button type="button" class="btn btn-secondary" id="cancel-student-modal-btn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="save-student-btn">Save Student Record</button>
        </div>
      </form>
    </div>
  </dialog>


  <!-- ==================== MODAL: REVIEW & CONFIRM ALERTS ==================== -->
  <dialog id="alert-modal" class="app-dialog">
    <div class="dialog-card dialog-lg">
      <div class="dialog-header">
        <div>
          <h2 class="dialog-title">Review &amp; Prepare Parent Alert</h2>
          <p class="dialog-subtitle" id="alert-modal-student-info">Student information</p>
        </div>
        <button type="button" class="close-btn" id="close-alert-modal-btn">&times;</button>
      </div>

      <div class="dialog-body">
        <input type="hidden" id="alert-student-id">

        <div class="form-group">
          <label class="field-label" for="alert-subject">Email Subject Line</label>
          <input type="text" id="alert-subject" class="form-input" maxlength="200">
        </div>

        <div class="form-group">
          <label class="field-label" for="alert-message">Notice Message Body (Editable)</label>
          <textarea id="alert-message" class="form-input form-textarea" rows="7" maxlength="2000"></textarea>
          <span class="field-help">This message is formatted for Gmail dispatch, manual WhatsApp chat, and SMS app pre-fill.</span>
        </div>

        <div class="channel-selection-card">
          <h4 class="channel-title">Select Notification Channels</h4>
          
          <label class="channel-checkbox">
            <input type="checkbox" id="channel-email" checked>
            <div class="channel-info">
              <span class="channel-name">Automatic University Gmail (SMTP)</span>
              <span class="channel-desc" id="channel-email-target">Target: parent email</span>
            </div>
            <span class="badge badge-success">Automated</span>
          </label>

          <label class="channel-checkbox" id="channel-wa-label">
            <input type="checkbox" id="channel-whatsapp" checked>
            <div class="channel-info">
              <span class="channel-name">Manual WhatsApp Click-to-Chat</span>
              <span class="channel-desc" id="channel-wa-target">Target: WhatsApp phone number</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <a id="modal-direct-wa-btn" target="_blank" rel="noopener noreferrer" class="btn btn-wa-link" style="padding: 4px 10px; font-size: 0.76rem; text-decoration: none;" title="Open WhatsApp Web/App immediately">Launch Chat</a>
              <span class="badge badge-warning">Manual</span>
            </div>
          </label>

          <label class="channel-checkbox" id="channel-sms-label">
            <input type="checkbox" id="channel-sms" checked>
            <div class="channel-info">
              <span class="channel-name">Manual System SMS Link</span>
              <span class="channel-desc" id="channel-sms-target">Target: SMS phone number</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <a id="modal-direct-sms-btn" class="btn btn-sms-link" style="padding: 4px 10px; font-size: 0.76rem; text-decoration: none;" title="Open SMS app immediately">Launch SMS</a>
              <span class="badge badge-warning">Manual</span>
            </div>
          </label>

          <div class="consent-alert" id="alert-consent-notice" style="display:none"></div>
        </div>
      </div>

      <div class="dialog-actions">
        <button type="button" class="btn btn-secondary" id="cancel-alert-modal-btn">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirm-send-alert-btn">Confirm &amp; Send</button>
      </div>
    </div>
  </dialog>


  <!-- ==================== MODAL: DELETE CONFIRMATION ==================== -->
  <dialog id="delete-modal" class="app-dialog">
    <div class="dialog-card dialog-sm">
      <div class="dialog-header">
        <h3 class="dialog-title text-danger">Delete Student Record</h3>
        <button type="button" class="close-btn" id="close-delete-modal-btn">&times;</button>
      </div>
      <div class="dialog-body">
        <p>Are you sure you want to delete student <strong id="delete-student-name"></strong> (<span id="delete-student-roll"></span>)?</p>
        <p class="field-help text-danger">This will permanently delete the student and their associated attendance history.</p>
        <input type="hidden" id="delete-student-id">
      </div>
      <div class="dialog-actions">
        <button type="button" class="btn btn-secondary" id="cancel-delete-btn">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirm-delete-btn">Delete Permanently</button>
      </div>
    </div>
  </dialog>


  <!-- ==================== TOAST NOTIFICATION BANNER ==================== -->
  <div id="toast" class="toast-notification" role="status"></div>

  <!-- Primary Application Script -->
  <script src="/app.js" defer></script>
</body>
</html>